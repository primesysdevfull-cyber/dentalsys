# Application
APP_NAME=DentalSysAPI
APP_PORT=3000
APP_ENV=development
APP_URL=http://localhost:3000
APP_FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dental_clinic?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRATION=7d

# 2FA
TOTP_ISSUER=DentalSys

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@dentalclinic.com.br

# WhatsApp (Evolution API / Z-API / Twilio)
WHATSAPP_API_URL=https://api.whatsapp.com/v1
WHATSAPP_API_TOKEN=your-whatsapp-token

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-sid
TWILIO_AUTH_TOKEN=your-token
TWILIO_PHONE_NUMBER=+5511999999999

# File Storage (MinIO / AWS S3)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_S3_BUCKET=dental-sys-files
STORAGE_S3_REGION=sa-east-1
STORAGE_S3_ACCESS_KEY=your-key
STORAGE_S3_SECRET_KEY=your-secret

# Stripe (Pagamentos)
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Throttling
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
